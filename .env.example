# ==============================================================================
# الموسوعة العُمانية الرقمية الذكية — Omani Digital Encyclopedia AI
# ملف المتغيرات البيئية لبيئة الإنتاج والتشغيل السحابي (.env.example)
# ==============================================================================

# 1. مفتاح واجهة برمجة تطبيقات Google Gemini (سري ومحمي في الخادم فقط)
# احصل على مفتاح مجاني 100% من: https://aistudio.google.com/
# لن يتم تسريب هذا المفتاح للمتصفح إطلاقاً؛ حيث يتم استدعاء الذكاء الاصطناعي حصرياً عبر API Route آمن على الخادم.
GEMINI_API_KEY=your_gemini_api_key_here

# 2. مفتاح تشفير جلسات لوحة الإدارة (SESSION_SECRET)
# يُستخدم لتوقيع رموز الجلسات (JWT / Cookies) الخاصة بحسابات المالك والمسؤولين لمنع التلاعب.
# يمكنك توليد سلسلة عشوائية من 32 حرفاً أو رقماً، مثال:
SESSION_SECRET=e7b4c91a82f345d061298abfc1472e39048a12dc56fe890123456789abcdef01

# 3. الرابط العام للموقع المباشر (لإعداد وسوم الميتا ومشاركة الروابط)
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# 4. مسار قاعدة بيانات SQLite (اختياري)
# الافتراضي: ./data/encyclopedia.db
# في بيئة Vercel يتم التحويل تلقائياً إلى /tmp/omani-encyclopedia-data/encyclopedia.db
SQLITE_DB_PATH=./data/encyclopedia.db

# 5. رابط قاعدة بيانات PostgreSQL السحابية (اختياري - عند استخدام Supabase أو Neon)
# احصل عليه مجاناً من https://supabase.com
# مثال:
# DATABASE_URL=postgres://postgres.xxxx:your_password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true
